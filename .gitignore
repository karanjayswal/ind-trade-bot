# Secrets — the access token lives in the environment, never in a file.
.env
indbot/config.json

# Runtime state
indbot/data/*.db
indbot/data/*.db-wal
indbot/data/*.db-shm
indbot/data/*.log
indbot/data/*.log.*
indbot/data/instruments/
indbot/data/backtest_cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Corporate CA bundle — contains an internal PKI root. Never publish.
cacert.pem
*.pem
*.crt

# Access token stored by the dashboard (mode 0600). Never publish.
indbot/data/token.txt
indbot/data/token.txt.tmp
